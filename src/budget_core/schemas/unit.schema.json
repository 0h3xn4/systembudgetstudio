{
  "$defs": {
    "Inertia": {
      "additionalProperties": false,
      "properties": {
        "ixx_kgm2": {
          "minimum": 0,
          "title": "Ixx Kgm2",
          "type": "number"
        },
        "ixy_kgm2": {
          "default": 0.0,
          "title": "Ixy Kgm2",
          "type": "number"
        },
        "ixz_kgm2": {
          "default": 0.0,
          "title": "Ixz Kgm2",
          "type": "number"
        },
        "iyy_kgm2": {
          "minimum": 0,
          "title": "Iyy Kgm2",
          "type": "number"
        },
        "iyz_kgm2": {
          "default": 0.0,
          "title": "Iyz Kgm2",
          "type": "number"
        },
        "izz_kgm2": {
          "minimum": 0,
          "title": "Izz Kgm2",
          "type": "number"
        }
      },
      "required": [
        "ixx_kgm2",
        "iyy_kgm2",
        "izz_kgm2"
      ],
      "title": "Inertia",
      "type": "object"
    },
    "MassProperties": {
      "additionalProperties": false,
      "description": "Centre-of-mass position (body frame, metres) and optional own inertia of one item.",
      "properties": {
        "inertia": {
          "anyOf": [
            {
              "$ref": "#/$defs/Inertia"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "position_m": {
          "items": {
            "type": "number"
          },
          "maxItems": 3,
          "minItems": 3,
          "title": "Position M",
          "type": "array"
        }
      },
      "required": [
        "position_m"
      ],
      "title": "MassProperties",
      "type": "object"
    },
    "PowerMode": {
      "additionalProperties": false,
      "description": "One power mode of a unit.\n\n`avg_power_w` is the average power drawn while the unit is in this mode and switched on;\nthe effective average is `avg_power_w * duty_cycle_ratio` (decision D-024).",
      "properties": {
        "avg_power_w": {
          "minimum": 0,
          "title": "Avg Power W",
          "type": "number"
        },
        "duty_cycle_ratio": {
          "default": 1.0,
          "maximum": 1,
          "minimum": 0,
          "title": "Duty Cycle Ratio",
          "type": "number"
        },
        "heat_dissipation_ratio": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Heat Dissipation Ratio"
        },
        "max_duration_s": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Duration S"
        },
        "min_duration_s": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Min Duration S"
        },
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "peak_power_w": {
          "minimum": 0,
          "title": "Peak Power W",
          "type": "number"
        }
      },
      "required": [
        "name",
        "avg_power_w",
        "peak_power_w"
      ],
      "title": "PowerMode",
      "type": "object"
    },
    "TemperatureLimits": {
      "additionalProperties": false,
      "description": "Operating and survival limits of a unit; a limit that is not given is not checked.",
      "properties": {
        "operating_max_k": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Operating Max K"
        },
        "operating_min_k": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Operating Min K"
        },
        "survival_max_k": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Survival Max K"
        },
        "survival_min_k": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Survival Min K"
        }
      },
      "title": "TemperatureLimits",
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "bus": {
      "minLength": 1,
      "title": "Bus",
      "type": "string"
    },
    "catalogue_ref": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Catalogue Ref"
    },
    "kind": {
      "const": "unit",
      "default": "unit",
      "title": "Kind",
      "type": "string"
    },
    "mass_kg": {
      "minimum": 0,
      "title": "Mass Kg",
      "type": "number"
    },
    "mass_properties": {
      "anyOf": [
        {
          "$ref": "#/$defs/MassProperties"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "maturity": {
      "minLength": 1,
      "title": "Maturity",
      "type": "string"
    },
    "modes": {
      "items": {
        "$ref": "#/$defs/PowerMode"
      },
      "minItems": 1,
      "title": "Modes",
      "type": "array"
    },
    "name": {
      "minLength": 1,
      "title": "Name",
      "type": "string"
    },
    "phases": {
      "anyOf": [
        {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Phases"
    },
    "schema_version": {
      "default": 2,
      "title": "Schema Version",
      "type": "integer"
    },
    "subsystem": {
      "minLength": 1,
      "title": "Subsystem",
      "type": "string"
    },
    "temperature_limits": {
      "anyOf": [
        {
          "$ref": "#/$defs/TemperatureLimits"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "thermal_node": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Thermal Node"
    }
  },
  "required": [
    "bus",
    "kind",
    "mass_kg",
    "maturity",
    "modes",
    "name",
    "schema_version",
    "subsystem"
  ],
  "title": "System Budget Studio unit",
  "type": "object"
}
