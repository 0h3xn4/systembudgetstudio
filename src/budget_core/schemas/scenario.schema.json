{
  "$defs": {
    "ScenarioRule": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "during_pass",
            "in_eclipse",
            "in_sunlight"
          ],
          "title": "Kind",
          "type": "string"
        },
        "lag_s": {
          "default": 0.0,
          "minimum": 0,
          "title": "Lag S",
          "type": "number"
        },
        "lead_s": {
          "default": 0.0,
          "minimum": 0,
          "title": "Lead S",
          "type": "number"
        },
        "mode": {
          "minLength": 1,
          "title": "Mode",
          "type": "string"
        },
        "site": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Site"
        }
      },
      "required": [
        "kind",
        "mode"
      ],
      "title": "ScenarioRule",
      "type": "object"
    },
    "ScenarioSegment": {
      "additionalProperties": false,
      "properties": {
        "duration_s": {
          "exclusiveMinimum": 0,
          "title": "Duration S",
          "type": "number"
        },
        "mode": {
          "minLength": 1,
          "title": "Mode",
          "type": "string"
        },
        "start_s": {
          "minimum": 0,
          "title": "Start S",
          "type": "number"
        }
      },
      "required": [
        "start_s",
        "duration_s",
        "mode"
      ],
      "title": "ScenarioSegment",
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Parameters of a scenario; computed results are never stored in the project (D-057).",
  "properties": {
    "default_mode": {
      "minLength": 1,
      "title": "Default Mode",
      "type": "string"
    },
    "description": {
      "default": "",
      "title": "Description",
      "type": "string"
    },
    "duration_s": {
      "exclusiveMinimum": 0,
      "title": "Duration S",
      "type": "number"
    },
    "environment_source": {
      "default": "elements",
      "enum": [
        "elements",
        "spacemissionstudio"
      ],
      "title": "Environment Source",
      "type": "string"
    },
    "import_dir": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Import Dir"
    },
    "kind": {
      "const": "scenario",
      "default": "scenario",
      "title": "Kind",
      "type": "string"
    },
    "mission_phase": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Mission Phase"
    },
    "name": {
      "minLength": 1,
      "title": "Name",
      "type": "string"
    },
    "orbit": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Orbit"
    },
    "rules": {
      "items": {
        "$ref": "#/$defs/ScenarioRule"
      },
      "title": "Rules",
      "type": "array"
    },
    "schema_version": {
      "default": 2,
      "title": "Schema Version",
      "type": "integer"
    },
    "segments": {
      "items": {
        "$ref": "#/$defs/ScenarioSegment"
      },
      "title": "Segments",
      "type": "array"
    },
    "shadow_model": {
      "default": "cylindrical",
      "enum": [
        "cylindrical",
        "conical"
      ],
      "title": "Shadow Model",
      "type": "string"
    },
    "sites": {
      "items": {
        "type": "string"
      },
      "title": "Sites",
      "type": "array"
    },
    "start_utc": {
      "title": "Start Utc",
      "type": "string"
    },
    "step_s": {
      "exclusiveMinimum": 0,
      "title": "Step S",
      "type": "number"
    }
  },
  "required": [
    "default_mode",
    "duration_s",
    "kind",
    "name",
    "schema_version",
    "start_utc",
    "step_s"
  ],
  "title": "System Budget Studio scenario",
  "type": "object"
}
