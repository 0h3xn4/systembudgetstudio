{
  "$defs": {
    "AttenuationEntry": {
      "additionalProperties": false,
      "properties": {
        "attenuation_kind": {
          "enum": [
            "rain",
            "gas",
            "cloud",
            "scintillation",
            "other"
          ],
          "title": "Attenuation Kind",
          "type": "string"
        },
        "elevation_deg": {
          "anyOf": [
            {
              "maximum": 90,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Elevation Deg"
        },
        "freq_hz": {
          "exclusiveMinimum": 0,
          "title": "Freq Hz",
          "type": "number"
        },
        "loss_db": {
          "$ref": "#/$defs/Sourced"
        },
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        }
      },
      "required": [
        "name",
        "attenuation_kind",
        "freq_hz",
        "loss_db"
      ],
      "title": "AttenuationEntry",
      "type": "object"
    },
    "Sourced": {
      "additionalProperties": false,
      "description": "A number from a standard, policy or data sheet. `source: TBD` or a null value marks a\nplaceholder that must be replaced before results are trusted (spec constraint 15).",
      "properties": {
        "note": {
          "default": "",
          "title": "Note",
          "type": "string"
        },
        "source": {
          "minLength": 1,
          "title": "Source",
          "type": "string"
        },
        "value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Value"
        }
      },
      "required": [
        "value",
        "source"
      ],
      "title": "Sourced",
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "entries": {
      "items": {
        "$ref": "#/$defs/AttenuationEntry"
      },
      "title": "Entries",
      "type": "array"
    },
    "kind": {
      "const": "attenuation_table",
      "default": "attenuation_table",
      "title": "Kind",
      "type": "string"
    },
    "schema_version": {
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    }
  },
  "required": [
    "kind",
    "schema_version"
  ],
  "title": "System Budget Studio attenuation_table",
  "type": "object"
}
